# Nightshade OS — ISO boot menu.
#
# Rendered by mkimage.sh (@VERSION@ / @LABEL@ substituted) into
# /boot/grub/grub.cfg on the ISO. The installed system does NOT use this file:
# there, grub.cfg is generated by update-grub so it can discover the ZFS root
# pool, and Nightshade's styling is applied through /etc/default/grub instead
# (see build/grub/default-grub.in).

insmod all_video
insmod gfxterm
insmod gfxmenu
insmod png
insmod part_gpt
insmod part_msdos
insmod fat
insmod iso9660
insmod search
insmod search_label

# 1024x768 is the resolution OVMF and essentially every real UEFI GOP will
# actually grant. "auto" alone lands on wildly different sizes and the theme
# geometry stops making sense.
set gfxmode=1024x768,800x600,auto
set gfxpayload=keep
terminal_output gfxterm

# Mirror the menu onto serial so a headless box (and `make test-vm`) can see
# and drive the boot menu. Harmless when no serial port exists.
insmod serial
if serial --unit=0 --speed=115200; then
  terminal_input console serial
  terminal_output gfxterm serial
fi

if loadfont $prefix/fonts/mono16.pf2; then
  loadfont $prefix/fonts/mono24.pf2
  if [ -f $prefix/themes/nightshade/theme.txt ]; then
    set theme=$prefix/themes/nightshade/theme.txt
    export theme
  fi
fi

set default=0
set timeout=5
set timeout_style=menu

# Shared kernel arguments.
#   boot=live                    - hand root over to live-boot
#   live-config.nocomponents     - live-config ships in the image but must stay
#                                  inert; nightshade-installer.service owns tty1
#                                  and there is no live-config-created user.
#   noeject noprompt             - do not stop for "remove the medium" at reboot
#   console=tty0 console=ttyS0   - last console wins /dev/console, so serial is
#                                  the one systemd talks to on a headless box
set nsargs="boot=live live-config.nocomponents noeject noprompt console=tty0 console=ttyS0,115200n8"

menuentry "Install Nightshade OS" --class nightshade {
    linux /live/vmlinuz $nsargs quiet loglevel=3
    initrd /live/initrd.img
}

menuentry "Install Nightshade OS (safe graphics / nomodeset)" --class nightshade {
    # Doubles as the debug entry: no `quiet`, so the full boot log is on screen
    # and on serial when the default entry fails somewhere unhelpful.
    linux /live/vmlinuz $nsargs nomodeset
    initrd /live/initrd.img
}
